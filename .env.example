SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
ADMIN_NAME=Certificate Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
INSTANCE_PATH=instance
DATABASE_PATH=instance/certificates.sqlite3
PDF_STORAGE_PATH=generated_certificates
PUBLIC_BASE_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5173
# SMTP is optional. Set these to your provider's actual values to enable email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=certificates@example.com
